# Trading pair to stream (default: BTC-USD)
# Other options: ETH-USD, SOL-USD, etc.
PRODUCT_ID=BTC-USD

# Postgres — start it with `docker compose up -d` from the project root,
# then apply migrations with `alembic upgrade head` (run from backend/).
DATABASE_URL=postgresql+asyncpg://marketpulse:marketpulse@localhost:5432/marketpulse

# How often (seconds) to persist an order book snapshot.
SNAPSHOT_INTERVAL_SECONDS=10

# LLM market narrator — runs against a local Ollama model, no API key needed.
# Install: brew install ollama && ollama pull llama3.2:3b
# Then make sure the Ollama server is running (brew services start ollama,
# or `ollama serve`) before starting the backend.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# How often (seconds) to generate a new market narration.
NARRATION_INTERVAL_SECONDS=45
